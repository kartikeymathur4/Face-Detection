# Copy to .env and edit. Never commit .env. No real credentials belong in this file.

# --- Admin access (required to view/delete users; enrollment too by default) ---
# Generate with:  python utils.py
ADMIN_PASSWORD_HASH=pbkdf2_sha256$200000$974497c0a16871d38b0700749150f680$b84c540ffb0f6112aee182a0665a0fa5f1ab3caf375b9f8754877a705b8a617a
REQUIRE_ADMIN_FOR_ENROLLMENT=true

# --- Privacy ---
# Days until an enrollment is deleted automatically. 0 = keep until deleted.
RETENTION_DAYS=365

# --- Paths ---
DATA_DIR=data
MODELS_DIR=models

# --- Camera ---
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
MIRROR_PREVIEW=true

# --- Detection ---
DETECT_INPUT_WIDTH=640
DETECT_SCORE_THRESHOLD=0.8

# --- Recognition (cosine similarity; NOT a probability) ---
RECOGNITION_THRESHOLD=0.363
AMBIGUITY_MARGIN=0.05
RECOGNIZE_EVERY_N_FRAMES=5
SMOOTHING_WINDOW=5
SMOOTHING_MIN_VOTES=3

# --- Enrollment quality ---
MIN_FACE_SIZE=80
BLUR_THRESHOLD=40
MIN_ENROLL_SAMPLES=3
MAX_ENROLL_SAMPLES=8

LOG_LEVEL=INFO
